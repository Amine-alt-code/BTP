@model IEnumerable<LocationBTP.Models.Entities.Reservation>
@using LocationBTP.Models.Enums

@{
    ViewData["Title"] = "Réservations";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa-solid fa-calendar-check me-2"></i>Réservations</h3>
    <a asp-action="Create" class="btn btn-dark">
        <i class="fa-solid fa-plus me-1"></i>Nouvelle Réservation
    </a>
</div>

<div class="card">
    <div class="card-body p-0">
        <table class="table table-vcenter card-table">
            <thead>
                <tr>
                    <th>Client</th>
                    <th>Machine</th>
                    <th>Date début</th>
                    <th>Date fin</th>
                    <th>Durée</th>
                    <th>Statut</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <div class="fw-bold">@item.Client?.Nom @item.Client?.Prenom</div>
                            <div class="text-muted small">@item.Client?.Email</div>
                        </td>
                        <td>@item.Machine?.Nom</td>
                        <td>@item.DateDebut.ToString("dd/MM/yyyy")</td>
                        <td>@item.DateFin.ToString("dd/MM/yyyy")</td>
                        <td>@((item.DateFin - item.DateDebut).Days) jours</td>
                        <td>
                            @switch (item.Statut)
                            {
                                case StatutReservation.EnAttente:
                                    <span class="badge bg-warning text-dark">En attente</span>
                                    break;
                                case StatutReservation.Confirmee:
                                    <span class="badge bg-success">Confirmée</span>
                                    break;
                                case StatutReservation.EnCours:
                                    <span class="badge bg-primary">En cours</span>
                                    break;
                                case StatutReservation.Terminee:
                                    <span class="badge bg-secondary">Terminée</span>
                                    break;
                                case StatutReservation.Annulee:
                                    <span class="badge bg-danger">Annulée</span>
                                    break;
                            }
                        </td>
                        <td>
                            <a asp-action="Details" asp-route-id="@item.Id"
                                   class="btn btn-sm btn-outline-dark">
                                <i class="fa-solid fa-eye me-1"></i>Détails
                            </a>
                            @if (item.Statut == StatutReservation.EnAttente)
                            {
                                <form asp-action="Confirmer" asp-route-id="@item.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-success ms-1">
                                        <i class="fa-solid fa-check me-1"></i>Confirmer
                                    </button>
                                </form>
                                <form asp-action="Annuler" asp-route-id="@item.Id"
                                      method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <button type="submit" class="btn btn-sm btn-danger ms-1"
                                            onclick="return confirm('Annuler cette réservation ?')">
                                        <i class="fa-solid fa-xmark me-1"></i>Annuler
                                    </button>
                                </form>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>