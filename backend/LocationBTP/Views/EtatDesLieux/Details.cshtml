@model LocationBTP.Models.Entities.EtatDesLieux
@using LocationBTP.Models.Enums

@{
    ViewData["Title"] = "État des Lieux";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa-solid fa-clipboard-list me-2"></i>État des Lieux #@Model.Id</h3>
    <a asp-action="Index" class="btn btn-outline-secondary">
        <i class="fa-solid fa-arrow-left me-1"></i>Retour
    </a>
</div>

<div class="row g-4">
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header" style="background:#000;color:#fff;">
                <h5 class="mb-0"><i class="fa-solid fa-info-circle me-2"></i>Informations</h5>
            </div>
            <div class="card-body">
                <dl class="row">
                    <dt class="col-sm-5">Type</dt>
                    <dd class="col-sm-7">
                        @if (Model.Type == TypeEtatDesLieux.Depart)
                        {
                            <span class="badge bg-primary">Départ</span>
                        }
                        else
                        {
                            <span class="badge bg-success">Retour</span>
                        }
                    </dd>
                    <dt class="col-sm-5">Date</dt>
                    <dd class="col-sm-7">@Model.Date.ToString("dd/MM/yyyy HH:mm")</dd>
                    <dt class="col-sm-5">Contrat</dt>
                    <dd class="col-sm-7">@Model.Contrat?.Numero</dd>
                    <dt class="col-sm-5">Machine</dt>
                    <dd class="col-sm-7">@Model.Contrat?.Reservation?.Machine?.Nom</dd>
                    <dt class="col-sm-5">Technicien</dt>
                    <dd class="col-sm-7">@Model.Technicien?.Nom @Model.Technicien?.Prenom</dd>
                    <dt class="col-sm-5">Niveau carburant</dt>
                    <dd class="col-sm-7">
                        <div class="progress" style="height:20px;">
                            <div class="progress-bar bg-warning" style="width:@Model.NiveauCarburant%">
                                @Model.NiveauCarburant%
                            </div>
                        </div>
                    </dd>
                    <dt class="col-sm-5">Conforme</dt>
                    <dd class="col-sm-7">
                        @if (Model.EstConforme)
                        {
                            <span class="badge bg-success"><i class="fa-solid fa-check me-1"></i>Oui</span>
                        }
                        else
                        {
                            <span class="badge bg-danger"><i class="fa-solid fa-xmark me-1"></i>Non</span>
                        }
                    </dd>
                    @if (!string.IsNullOrEmpty(Model.Observations))
                    {
                        <dt class="col-sm-5">Observations</dt>
                        <dd class="col-sm-7">@Model.Observations</dd>
                    }
                </dl>
                <div class="mt-3">
                    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-outline-dark btn-sm">
                        <i class="fa-solid fa-pen me-1"></i>Modifier
                    </a>
                </div>
            </div>
        </div>
    </div>

    <!-- Photos -->
    <div class="col-md-6">
        <div class="card h-100">
            <div class="card-header" style="background:#000;color:#fff;">
                <h5 class="mb-0">
                    <i class="fa-solid fa-camera me-2"></i>Photos
                    <span class="badge bg-secondary ms-2">@(Model.Photos?.Count ?? 0)</span>
                </h5>
            </div>
            <div class="card-body">
                @if (Model.Photos != null && Model.Photos.Any())
                {
                    <div class="row g-2">
                        @foreach (var photo in Model.Photos)
                        {
                            <div class="col-6">
                                <a href="@photo.CheminFichier" target="_blank">
                                    <img src="@photo.CheminFichier"
                                         class="img-fluid rounded"
                                         style="height:140px;width:100%;object-fit:cover;"
                                         alt="Photo état des lieux" />
                                </a>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="text-center text-muted py-4">
                        <i class="fa-solid fa-camera fa-3x mb-3"></i>
                        <p>Aucune photo</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>