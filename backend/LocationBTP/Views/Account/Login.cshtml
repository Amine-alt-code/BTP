@{
    ViewData["Title"] = "Connexion";
    Layout = "_Layout";
}

<div class="container-xl">
    <div class="row justify-content-center mt-5">
        <div class="col-md-5">

            <!-- En-tête -->
            <div class="text-center mb-4">
                <h1 class="fw-bold">LocationBTP</h1>
                <p class="text-muted">Gestionnaire de Location de Materiel BTP</p>
            </div>

            <!-- Card Login -->
            <div class="card shadow-sm">
                <div class="card-header text-center py-3">
                    <h3 class="card-title mb-0">Connexion</h3>
                </div>
                <div class="card-body p-4">

                    @if (ViewBag.Error != null)
                    {
                        <div class="alert alert-danger" role="alert">
                            @ViewBag.Error
                        </div>
                    }

                    <form method="post" asp-action="Login" asp-controller="Account">

                        <div class="mb-3">
                            <label class="form-label">Adresse Email</label>
                            <input type="email"
                                   name="email"
                                   class="form-control"
                                   placeholder="exemple@btp.com"
                                   required
                                   autofocus />
                        </div>

                        <div class="mb-4">
                            <label class="form-label">Mot de passe</label>
                            <input type="password"
                                   name="password"
                                   class="form-control"
                                   placeholder="••••••••"
                                   required />
                        </div>

                        <button type="submit" class="btn btn-primary w-100 py-2">
                            Se connecter
                        </button>

                    </form>

                </div>
                <div class="card-footer text-center text-muted py-3">
                    &copy; 2026 - LocationBTP
                </div>
            </div>

        </div>
    </div>
</div>