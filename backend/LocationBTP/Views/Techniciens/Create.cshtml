@model LocationBTP.Models.Entities.Technicien

@{
    ViewData["Title"] = "Nouveau Technicien";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa-solid fa-helmet-safety me-2"></i>Nouveau Technicien</h3>
</div>
<hr />

<div class="row">
    <div class="col-md-6">
        <div class="card">
            <div class="card-header" style="background:#000;color:#fff;">
                <h5 class="mb-0">Informations du technicien</h5>
            </div>
            <div class="card-body">
                <form asp-action="Create">
                    <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                    <div class="row g-3 mb-3">
                        <div class="col-md-6">
                            <label asp-for="Nom" class="form-label fw-bold">Nom</label>
                            <input asp-for="Nom" class="form-control" placeholder="Nom" />
                            <span asp-validation-for="Nom" class="text-danger"></span>
                        </div>
                        <div class="col-md-6">
                            <label asp-for="Prenom" class="form-label fw-bold">Prénom</label>
                            <input asp-for="Prenom" class="form-control" placeholder="Prénom" />
                            <span asp-validation-for="Prenom" class="text-danger"></span>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Email" class="form-label fw-bold">Email</label>
                        <input asp-for="Email" class="form-control" placeholder="email@exemple.com" />
                        <span asp-validation-for="Email" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Telephone" class="form-label fw-bold">Téléphone</label>
                        <input asp-for="Telephone" class="form-control" placeholder="06 00 00 00 00" />
                        <span asp-validation-for="Telephone" class="text-danger"></span>
                    </div>

                    <div class="mb-3">
                        <label asp-for="Login" class="form-label fw-bold">Login</label>
                        <input asp-for="Login" class="form-control" placeholder="Login de connexion" />
                        <span asp-validation-for="Login" class="text-danger"></span>
                    </div>

                    <div class="mb-4">
                        <label asp-for="PasswordHash" class="form-label fw-bold">Mot de passe</label>
                        <input asp-for="PasswordHash" class="form-control"
                               type="password" placeholder="Minimum 6 caractères" />
                        <span asp-validation-for="PasswordHash" class="text-danger"></span>
                    </div>

                    <div class="d-flex gap-2">
                        <button type="submit" class="btn btn-dark">
                            <i class="fa-solid fa-save me-1"></i>Créer
                        </button>
                        <a asp-action="Index" class="btn btn-outline-secondary">Annuler</a>
                    </div>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }
}