@model IEnumerable<LocationBTP.Models.Entities.Notification>

@{
    ViewData["Title"] = "Notifications";
}

<div class="d-flex justify-content-between align-items-center mb-4">
    <h3><i class="fa-solid fa-bell me-2"></i>Notifications</h3>
    <span class="badge bg-danger fs-6">
        @Model.Count(n => !n.EstLue) non lues
    </span>
</div>

<div class="card">
    <div class="card-body p-0">
        @foreach (var notif in Model)
        {
            <div class="p-3 border-bottom @(notif.EstLue ? "" : "bg-light")">
                <div class="d-flex justify-content-between align-items-start">
                    <div class="d-flex gap-3">
                        <div>
                            @switch (notif.Type)
                            {
                                case "RemboursementCaution":
                                    <span class="avatar bg-success text-white">
                                        <i class="fa-solid fa-money-bill"></i>
                                    </span>
                                    break;
                                case "CautionRetenue":
                                    <span class="avatar bg-danger text-white">
                                        <i class="fa-solid fa-ban"></i>
                                    </span>
                                    break;
                                case "Confirmation":
                                    <span class="avatar bg-primary text-white">
                                        <i class="fa-solid fa-check"></i>
                                    </span>
                                    break;
                                case "DemandeReservation":
                                    <span class="avatar bg-warning text-dark">
                                        <i class="fa-solid fa-calendar"></i>
                                    </span>
                                    break;
                                default:
                                    <span class="avatar bg-secondary text-white">
                                        <i class="fa-solid fa-bell"></i>
                                    </span>
                                    break;
                            }
                        </div>
                        <div>
                            <div class="fw-bold">
                                @notif.Type
                                @if (!notif.EstLue)
                                {
                                    <span class="badge bg-danger ms-1">Nouveau</span>
                                }
                            </div>
                            <div class="text-muted">@notif.Message</div>
                            <div class="text-muted small mt-1">
                                <i class="fa-solid fa-clock me-1"></i>
                                @notif.DateEnvoi.ToString("dd/MM/yyyy HH:mm")
                                — <strong>@notif.Client?.Nom @notif.Client?.Prenom</strong>
                            </div>
                        </div>
                    </div>
                    <div class="d-flex gap-2">
                        @if (notif.Type == "RemboursementCaution" &&
                             notif.Reservation?.Contrat?.Caution != null &&
                             notif.Reservation.Contrat.Caution.Statut == LocationBTP.Models.Enums.StatutCaution.ARemborser)
                        {
                            <form asp-controller="Reservations" asp-action="RembourserCaution"
                                  asp-route-id="@notif.Reservation.Contrat.Caution.Id" method="post">
                                @Html.AntiForgeryToken()
                                <button type="submit" class="btn btn-sm btn-success"
                                        onclick="return confirm('Confirmer le remboursement ?')">
                                    <i class="fa-solid fa-money-bill me-1"></i>Rembourser
                                </button>
                            </form>
                        }
                        <a asp-controller="Reservations" asp-action="Details"
                               asp-route-id="@notif.ReservationId"
                               class="btn btn-sm btn-outline-dark">
                            <i class="fa-solid fa-eye me-1"></i>Voir
                        </a>
                    </div>
                </div>
            </div>
        }
        @if (!Model.Any())
        {
            <div class="text-center text-muted py-5">
                <i class="fa-solid fa-bell-slash fa-3x mb-3"></i>
                <p>Aucune notification</p>
            </div>
        }
    </div>
</div>